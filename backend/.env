# Backend config. Override machine-specific values in .env.local (gitignored).
# Bun loads this from the cwd, so run bun commands from backend/.

# THE port. Dev or prod, this is the only URL you open: http://localhost:3000
PORT=3000
HOST=0.0.0.0

# SQLite database (state changes + watering events). Relative to repo root.
DB_PATH=state/rcflower.db

# Built frontend served in production (bun run start). Relative to repo root.
FRONTEND_DIST=frontend/dist

# DEV ONLY: where `bun run dev` spawns its internal Vite child process
# (frontend compiler + hot reload). Bun proxies to it; it's bound to loopback
# and prints no banner. Don't open it directly -- you'll get the frontend
# without any /api routes.
VITE_HOST=127.0.0.1
VITE_PORT=5173
