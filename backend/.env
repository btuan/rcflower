# Backend config. Override machine-specific values in .env.local (gitignored).

# Port the Bun server listens on. This is the only port you need to hit --
# in dev it proxies non-/api requests to Vite; in prod it serves frontend/dist.
PORT=3000
HOST=0.0.0.0

# Detection state written by the (separate) Python vision service.
# Path is resolved relative to the repo root.
STATE_PATH=state/detections.json

# Built frontend served in production (bun run start). Relative to repo root.
FRONTEND_DIST=frontend/dist

# Vite dev server that `bun run dev` spawns and proxies to.
VITE_HOST=127.0.0.1
VITE_PORT=5173

# How often (ms) to re-read the detection state file.
POLL_INTERVAL_MS=200
