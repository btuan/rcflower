# Template: install-systemd.sh fills in the @TOKENS@ and installs the result.
# Edit this file (not /etc/systemd/system/), then re-run that
# script (not `systemctl edit`) so the repo stays the source of truth.
[Unit]
Description=rcflower person detection (YOLOv8n NCNN, headless)
After=network.target rcflower-backend.service
Wants=rcflower-backend.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO_ROOT@/python
Environment=PATH=@UV_DIR@:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=@UV_DIR@/uv run --no-dev python -u detect.py --config detect-config.prod.yaml
Restart=on-failure
RestartSec=3
# POSTs to the backend are best-effort (logs + continues on failure), so this
# doesn't hard-require the backend to be up -- Wants=/After= just order boot.
# stdout/stderr go to the journal -- `journalctl -u rcflower-detect -f`

[Install]
WantedBy=multi-user.target
