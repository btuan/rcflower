# Installed via deploy/install-systemd.sh -- edit this file, then re-run that
# script (not `systemctl edit`) so the repo stays the source of truth.
[Unit]
Description=rcflower person detection (YOLOv8n TFLite, headless)
After=network.target rcflower-backend.service
Wants=rcflower-backend.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/code/rcflower/python
ExecStart=/home/pi/code/rcflower/python/venv/bin/python3 -u detect.py --headless --camera 0 --classes person
Restart=on-failure
RestartSec=3
# POSTs to the backend are best-effort (logs + continues on failure), so this
# doesn't hard-require the backend to be up -- Wants=/After= just order boot.
# stdout/stderr go to the journal -- `journalctl -u rcflower-detect -f`

[Install]
WantedBy=multi-user.target
